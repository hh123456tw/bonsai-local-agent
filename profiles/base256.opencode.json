{
  "model": {
    "providerID": "bonsai",
    "model": "bonsai2-27b"
  },
  "default_agent": "build",
  "providers": {
    "bonsai": {
      "name": "Bonsai Local Guard",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8081/v1",
        "apiKey": "local"
      },
      "models": {
        "bonsai2-27b": {
          "name": "Bonsai Basic 256K",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "permissions": [
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 32768
  },
  "plugins": [
    "-orca-opencode-status",
    "-superpowers"
  ]
}
